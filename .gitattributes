# Files whose exact bytes are hashed or signed: never convert line endings on checkout.
# Without this, Git for Windows (core.autocrlf) rewrote LF as CRLF in the contract vectors and their
# sha256 no longer matched CONTRACT.md (docs/GATE_CONTRACT.md, 2026-09-26).
contract/gate_vectors.jsonl -text
evidence/*.json -text
evidence/*.sig -text
witness/packages.log -text
keys/allowed_signers -text
runs/**/*.json -text
# Verbatim external texts whose sha256 is recorded in their header: keep their exact bytes (JG-2, F1).
docs/external/*.md -text
# P-001 B06: every archived sv.package/0 is hashed byte for byte (tests/p001/legacy_manifest_709da9e.sha256),
# including those below evidence/ and results/ that the patterns above do not reach.
evidence/**/*.json -text
results/**/*.json -text
tests/p001/*.sha256 -text
